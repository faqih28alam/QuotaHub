# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env.

# MongoDB. Local process on the host uses localhost.
# docker-compose.prod.yml replaces this with the authenticated Mongo service.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=quotahub

# development keeps /docs and /redoc. production turns them off.
ENVIRONMENT=development

# Comma-separated browser origins. No trailing slash.
# Production must include the Vercel URL and any custom domain, for example:
# CORS_ORIGINS=https://quotahub.vercel.app,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to false on any server that stores real API keys.
ALLOW_SIGNUP=true

# Optional. Tailscale URL checks use this proxy. Leave empty until the proxy is running.
# Example on the server: socks5h://tailscale:1055
TAILSCALE_SOCKS_PROXY=
MONITOR_CHECK_INTERVAL_SECONDS=60

# AES-256-GCM master key, 32 bytes, base64.
# Keep a copy in a password manager. If this key is lost, stored API keys cannot be decrypted.
# python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
APP_MASTER_ENCRYPTION_KEY=

# Long random string used to sign login tokens. Startup refuses placeholders.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# First admin account created on sign-in. Choose your own.
# Startup refuses a blank or placeholder password (changeme, password, admin, ...).
DEFAULT_USERNAME=
DEFAULT_PASSWORD=
