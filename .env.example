# Frontend (Next.js). NEXT_PUBLIC_* is baked into the browser bundle at build time.
# Local dev: copy this line into .env.local
# Vercel: set it in Project Settings → Environment Variables before deploying.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production server only (docker-compose.prod.yml).
# Copy this file to .env in the repo root on the server and replace the values.
# Use letters and digits only in the Mongo password so the connection string stays valid.
API_DOMAIN=api.example.com
MONGO_ROOT_USERNAME=quotahub
MONGO_ROOT_PASSWORD=replace-with-a-long-alphanumeric-password

# Optional. Used only with: docker compose -f docker-compose.prod.yml --profile tailscale up -d
TS_AUTHKEY=
